{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/apps/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/web/**",
              "ui_kits/destina-home/**",
              "ui_kits/dg-apps/**",
              "ui_kits/market-intelligence/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Outfit|Montserrat))/i]",
        "message": "Font not provided by the design system. Available: Inter, Outfit, Montserrat."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|right|accent|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AccentRow> doesn't accept that prop. Declared props: title, meta, right, accent, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ActionButton> doesn't accept that prop. Declared props: children, tone, icon, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|red|yellow|graphite)$/]",
        "message": "<ActionButton> tone must be one of 'blue' | 'red' | 'yellow' | 'graphite'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|icon|accent|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AppCard> doesn't accept that prop. Declared props: title, description, icon, accent, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppCard'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:blue|green|red|yellow|purple|teal|indigo|pink)$/]",
        "message": "<AppCard> accent must be one of 'blue' | 'green' | 'red' | 'yellow' | 'purple' | 'teal' | 'indigo' | 'pink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|dot|size|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, dot, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|success|danger|warning|neutral|in|pause|other|national|local|regional)$/]",
        "message": "<Badge> tone must be one of 'primary' | 'success' | 'danger' | 'warning' | 'neutral' | 'in' | 'pause' | 'other' | 'national' | 'local' | 'regional'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|block|icon|iconRight|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, block, icon, iconRight, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger|warning)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|interactive|featured|padding|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, interactive, featured, padding, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DGAppCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:app|user|children|footer|wide|monogramSrc|style|key|ref|className|style|children)$/]",
        "message": "<DGAppCard> doesn't accept that prop. Declared props: app, user, children, footer, wide, monogramSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<GlassChip> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<InfoPanel> doesn't accept that prop. Declared props: children, title, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|danger)$/]",
        "message": "<InfoPanel> tone must be one of 'info' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|icon|as|options|type|value|defaultValue|placeholder|disabled|onChange|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, icon, as, options, type, value, defaultValue, placeholder, disabled, onChange, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea|select)$/]",
        "message": "<Input> as must be one of 'input' | 'textarea' | 'select'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|footer|onClose|width|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, children, footer, onClose, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|action|variant|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: children, title, action, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:tinted|plain|muted)$/]",
        "message": "<Panel> variant must be one of 'tinted' | 'plain' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<PillLabel> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|delta|icon|accent|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value, unit, delta, icon, accent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<TabBarItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|width|render|key|ref|className|style|children)$/]",
        "message": "<TableColumn> doesn't accept that prop. Declared props: key, label, align, width, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<TableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WebNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|active|cta|logoSrc|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<WebNav> doesn't accept that prop. Declared props: links, active, cta, logoSrc, onNavigate, style."
      }
    ]
  },
